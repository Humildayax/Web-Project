# ---- Postgres ----
DB_USER=testUser
DB_PASSWORD=testPasswd
DB_NAME=security_incidents
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
# Tuning del pool (opcional, tienen defaults razonables)
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE=30m
# DB_HEALTHCHECK_PERIOD=1m

# ---- HTTP ----
HTTP_ADDR=:8080
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=15s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_MAX_BODY_BYTES=1048576

# ---- News ----
NEWS_FEED_URL=https://feeds.feedburner.com/TheHackersNews
NEWS_LIMIT=5
NEWS_CACHE_TTL=15m

# ---- JIRA (Cloud REST API v3) ----
# Poné JIRA_ENABLED=true cuando tengas credenciales reales.
# El API token se saca en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_ENABLED=false
JIRA_BASE_URL=https://tu-org.atlassian.net
JIRA_EMAIL=usuario@tu-org.com
JIRA_API_TOKEN=reemplazar_por_token
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task
JIRA_HTTP_TIMEOUT=10s
JIRA_RETRY_INTERVAL=5m
JIRA_MAX_RETRIES=10
