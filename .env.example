# ---- Postgres ----
DB_USER=testUser
DB_PASSWORD=testPasswd
DB_NAME=security_incidents
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
# Tuning del pool (opcional, tienen defaults razonables)
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE=30m
# DB_HEALTHCHECK_PERIOD=1m
# Timeout por operación de repositorio (Create, MarkSynced, ClaimPendingSync…).
# DB_OP_TIMEOUT=5s

# Si está en true (default) el backend corre las migraciones embebidas al
# arrancar. Poner en false en entornos donde se aplican por separado
# (CI/CD, operador con la CLI de golang-migrate).
# MIGRATE_ON_START=true

# ---- HTTP ----
HTTP_ADDR=:8080
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=15s
# HTTP_IDLE_TIMEOUT=60s
# Body máximo aceptado por el backend. Default 30 MiB para soportar
# multipart con hasta 5 imágenes de 5 MB. nginx aplica el primer corte
# (client_max_body_size 30m).
# HTTP_MAX_BODY_BYTES=31457280
# Orígenes permitidos por CORS (separados por coma).
# - Sin esta variable: default de dev http://localhost:5173.
# - Con valor: lista de orígenes permitidos.
# - Vacío (ALLOWED_ORIGINS=): CORS deshabilitado, útil cuando front y back
#   viven detrás del mismo reverse proxy y no hace falta el middleware.
ALLOWED_ORIGINS=http://localhost:5173

# Rate-limit de POST /api/incidents (por IP del cliente).
# INCIDENT_RATE_LIMIT=10
# INCIDENT_RATE_WINDOW=1m

# ---- News ----
# Lista de feeds RSS a consumir (CSV). Si está vacía o no se setea, se usan
# los 4 defaults curados:
#   - feeds.feedburner.com/TheHackersNews   (EN, internacional)
#   - feeds.feedburner.com/welivesecurity   (ES, ESET, técnico)
#   - cybersecuritynews.es/feed/            (ES, actualidad)
#   - impactotic.co/ciber-seguridad/feed/   (Colombia, contexto local)
# NEWS_FEED_URLS=https://feeds.feedburner.com/TheHackersNews,https://feeds.feedburner.com/welivesecurity,https://cybersecuritynews.es/feed/,https://impactotic.co/ciber-seguridad/feed/

# Cuántas noticias mostrar de CADA feed. Con 4 feeds default y 3 por feed,
# la página termina con ~12 ítems agrupados por fuente.
NEWS_LIMIT_PER_SOURCE=3
NEWS_CACHE_TTL=15m

# ---- Adjuntos en reportes ----
# Path de almacenamiento de los binarios (filesystem). En docker-compose
# va al volumen attachments_data:/data/incidents.
# STORAGE_BASE_PATH=/data/incidents

# Cotas de seguridad. Se aplican en el handler ANTES de tocar disco.
# El frontend espeja estos valores como UX, pero el backend es la
# autoridad final.
# ATTACHMENT_MAX_FILES=5
# ATTACHMENT_MAX_FILE_BYTES=5242880    # 5 MiB
# ATTACHMENT_MAX_IMAGE_DIM=4096        # ancho/alto máximo en pixels
# ATTACHMENT_PARSE_MEMORY=10485760     # RAM antes de spillar a temp files

# ---- Retention (PII en metadata de incidentes) ----
# Tras INCIDENT_METADATA_MAX_AGE, un worker pone metadata = NULL en los
# incidentes viejos (la fila se conserva, solo se borra IP + UA + received_at).
# Poner en 0 deshabilita el worker.
# INCIDENT_METADATA_MAX_AGE=2160h   # 90 días
# RETENTION_INTERVAL=24h

# ---- JIRA (Cloud REST API v3) ----
# Poné JIRA_ENABLED=true cuando tengas credenciales reales.
# El API token se saca en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_ENABLED=false
# "Domain" en n8n -> URL completa acá.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=replace_with_real_token
# Key del proyecto (la URL de JIRA: .../projects/<KEY>/...). NO el nombre.
JIRA_PROJECT_KEY=PROJ
JIRA_ISSUE_TYPE=Task
JIRA_HTTP_TIMEOUT=10s
JIRA_RETRY_INTERVAL=5m
JIRA_MAX_RETRIES=10
# Backoff base entre reintentos: el N-ésimo fallo espera BASE_BACKOFF * 2^N
# antes de volver a intentarse. Evita martillar a JIRA cuando está caído.
# JIRA_RETRY_BASE_BACKOFF=30s
# Cuántos adjuntos sube el worker a JIRA por tick (acota la latencia
# del worker cuando hay backlog).
# JIRA_ATTACHMENT_BATCH_SIZE=20

# Campos opcionales del ticket. Si están vacíos, se omiten del payload y
# JIRA aplica su default.
#
# Cómo conseguir los accountIds: visitando logueado
#   https://<TU-DOMINIO>.atlassian.net/rest/api/3/myself
# Cómo conseguir el id del custom field "Start date":
#   https://<TU-DOMINIO>.atlassian.net/rest/api/3/field
#   (buscar name: "Start date", copiar el "id")
JIRA_ASSIGNEE_ACCOUNT_ID=
JIRA_REPORTER_ACCOUNT_ID=
JIRA_PRIORITY_NAME=
JIRA_PARENT_ID=
# Mapea incident.created_at (formato YYYY-MM-DD) al custom field de Start date.
JIRA_START_DATE_FIELD_ID=

# Epic Link (solo para JIRA Software CLASSIC).
# En Classic, vincular un issue a un Epic NO se hace con `parent`, sino con
# un custom field (típicamente customfield_10014) y la KEY del epic, no su
# id numérico.
#
# Si parent ya funciona en tu instancia (proyectos modernos / next-gen),
# DEJALAS COMENTADAS. Si tras un reporte el ticket no queda dentro del
# epic, descomentá estas dos:
# JIRA_EPIC_LINK_FIELD_ID=customfield_10014
# JIRA_EPIC_LINK_VALUE=PROJ-1          # reemplazar por la KEY del epic real
