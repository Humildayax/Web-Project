# ---- Postgres ----
DB_USER=testUser
DB_PASSWORD=testPasswd
DB_NAME=security_incidents
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable
# Tuning del pool (opcional, tienen defaults razonables)
# DB_MAX_CONNS=10
# DB_MIN_CONNS=2
# DB_MAX_CONN_LIFETIME=1h
# DB_MAX_CONN_IDLE=30m
# DB_HEALTHCHECK_PERIOD=1m
# Timeout por operación de repositorio (Create, MarkSynced, ClaimPendingSync…).
# DB_OP_TIMEOUT=5s

# Si está en true (default) el backend corre las migraciones embebidas al
# arrancar. Poner en false en entornos donde se aplican por separado
# (CI/CD, operador con la CLI de golang-migrate).
# MIGRATE_ON_START=true

# ---- HTTP ----
HTTP_ADDR=:8080
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=15s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_MAX_BODY_BYTES=1048576
# Orígenes permitidos por CORS (separados por coma).
# - Sin esta variable: default de dev http://localhost:5173.
# - Con valor: lista de orígenes permitidos.
# - Vacío (ALLOWED_ORIGINS=): CORS deshabilitado, útil cuando front y back
#   viven detrás del mismo reverse proxy y no hace falta el middleware.
ALLOWED_ORIGINS=http://localhost:5173

# Rate-limit de POST /api/incidents (por IP del cliente).
# INCIDENT_RATE_LIMIT=10
# INCIDENT_RATE_WINDOW=1m

# ---- News ----
NEWS_FEED_URL=https://feeds.feedburner.com/TheHackersNews
NEWS_LIMIT=5
NEWS_CACHE_TTL=15m

# ---- Retention (PII en metadata de incidentes) ----
# Tras INCIDENT_METADATA_MAX_AGE, un worker pone metadata = NULL en los
# incidentes viejos (la fila se conserva, solo se borra IP + UA + received_at).
# Poner en 0 deshabilita el worker.
# INCIDENT_METADATA_MAX_AGE=2160h   # 90 días
# RETENTION_INTERVAL=24h

# ---- JIRA (Cloud REST API v3) ----
# Poné JIRA_ENABLED=true cuando tengas credenciales reales.
# El API token se saca en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_ENABLED=false
JIRA_BASE_URL=https://tu-org.atlassian.net
JIRA_EMAIL=usuario@tu-org.com
JIRA_API_TOKEN=reemplazar_por_token
JIRA_PROJECT_KEY=SEC
JIRA_ISSUE_TYPE=Task
JIRA_HTTP_TIMEOUT=10s
JIRA_RETRY_INTERVAL=5m
JIRA_MAX_RETRIES=10
# Backoff base entre reintentos: el N-ésimo fallo espera BASE_BACKOFF * 2^N
# antes de volver a intentarse. Evita martillar a JIRA cuando está caído.
# JIRA_RETRY_BASE_BACKOFF=30s
